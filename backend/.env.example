DATABASE_URL=postgresql+psycopg://maison:maison_dev_password@localhost:5432/maison_guillard
JWT_SECRET=replace-with-a-long-random-string
SEED_ADMIN_EMAIL=admin@maisonguillard.fr
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
TEST_DATABASE_URL=postgresql+psycopg://maison:maison_dev_password@localhost:5432/maison_guillard_test

# E-mails de demande (toujours envoyés ; une panne d'envoi est journalisée et ne bloque pas la demande).
# En dev : Gmail + mot de passe d'application. Au déploiement : SMTP de l'hébergeur et adresse de l'artisane.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-d-application
EMAIL_EXPEDITEUR=adresse@gmail.com
EMAIL_ARTISAN=adresse@gmail.com
# Adresse publique du site, utilisée dans le lien du devis envoyé au client.
SITE_URL=http://localhost:5173

# Stripe (mode test en dev : cartes de test, `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
# Clés réelles seulement à la mise en ligne, sur le compte Stripe de l'artisane.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Production seulement (Render) : voir render.yaml et docs/deploiement.md ----
# APP_ENV=production active des contrôles au démarrage : l'API refuse de démarrer si un réglage manque.
APP_ENV=development
# Origine(s) autorisée(s) à appeler l'API depuis le navigateur (l'adresse du site), séparées par des virgules.
CORS_ORIGINS=
# 1 derrière le proxy de l'hébergeur : la limitation de requêtes lit alors la vraie adresse du visiteur.
TRUST_PROXY=0
# Photos : sans cette variable les images vont dans backend/uploads/ (développement).
# En production : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# 1 pour garder la documentation Swagger (/docs) ouverte en production.
DOCS_ENABLED=0

